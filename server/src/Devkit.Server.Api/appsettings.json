{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=Devkit;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "Devkit.Server",
    "Audience": "Devkit.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Registration": {
    "Enabled": false
  },
  "BootstrapAccount": {
    "Enabled": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false",
    "InstanceName": "devkit:",
    "ProfileTtlMinutes": 5
  },
  "ModuleControl": {
    "Enabled": false,
    "OfflineAfterSeconds": 30,
    "DefaultLeaseSeconds": 60,
    "MaximumLeaseSeconds": 300,
    "MaximumPayloadBytes": 262144
  },
  "Navigation": {
    "Common": [
      {
        "Id": "home",
        "Title": "首页",
        "TargetKey": "home",
        "IconKey": "home",
        "Order": 0,
        "IsClosable": false
      },
      {
        "Id": "system",
        "Title": "系统",
        "IconKey": "system",
        "Order": 100
      },
      {
        "Id": "system.monitoring",
        "ParentId": "system",
        "Title": "运行监控",
        "IconKey": "monitor",
        "Order": 110
      },
      {
        "Id": "system.status",
        "ParentId": "system.monitoring",
        "Title": "系统状态",
        "TargetKey": "system-status",
        "IconKey": "pulse",
        "Order": 111
      },
      {
        "Id": "system.settings",
        "ParentId": "system",
        "Title": "设置",
        "TargetKey": "settings",
        "IconKey": "settings",
        "Order": 120
      },
      {
        "Id": "system.about",
        "ParentId": "system",
        "Title": "关于",
        "TargetKey": "about",
        "IconKey": "info",
        "Order": 130
      }
    ],
    "Web": [
      { "Id": "exam-study", "Title": "制度学习", "IconKey": "book", "Order": 20, "RequiredPermission": "exam-study.access" },
      { "Id": "exam-study.knowledge", "ParentId": "exam-study", "Title": "知识库", "TargetKey": "study-knowledge", "Order": 21, "RequiredPermission": "exam-study.access" },
      { "Id": "exam-study.projects", "ParentId": "exam-study", "Title": "备考项目 · 快速查询", "TargetKey": "study-projects", "Order": 22, "RequiredPermission": "exam-study.access" },
      { "Id": "exam-study.questions", "ParentId": "exam-study", "Title": "题库", "TargetKey": "study-questions", "Order": 23, "RequiredPermission": "exam-study.access" },
      { "Id": "exam-study.jobs", "ParentId": "exam-study", "Title": "处理任务", "TargetKey": "study-jobs", "Order": 24, "RequiredPermission": "exam-study.access" },
      { "Id": "system.files", "ParentId": "system", "Title": "文件管理", "TargetKey": "system-files", "Order": 140, "RequiredPermission": "system.files.manage" },
      { "Id": "system.storage", "ParentId": "system", "Title": "存储与迁移", "TargetKey": "system-storage", "Order": 150, "RequiredPermission": "system.storage.manage" },
      { "Id": "system.identity", "ParentId": "system", "Title": "用户与权限", "TargetKey": "system-identity", "Order": 160, "RequiredPermission": "system.identity.manage" },
      {
        "Id": "system.about",
        "ParentId": "system",
        "Title": "关于 Web",
        "TargetKey": "about",
        "IconKey": "info",
        "Order": 130
      }
    ],
    "Client": [
      {
        "Id": "system.about",
        "ParentId": "system",
        "Title": "关于客户端",
        "TargetKey": "about",
        "IconKey": "info",
        "Order": 130
      }
    ]
  },
  "BackgroundJobs": {
    "RefreshTokenCleanup": {
      "Enabled": true,
      "IntervalMinutes": 60
    }
  }
}
