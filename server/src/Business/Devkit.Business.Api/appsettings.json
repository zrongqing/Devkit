{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "Devkit.Server",
    "Audience": "Devkit.Clients"
  },
  "ModuleControl": {
    "Enabled": false,
    "OfflineAfterSeconds": 30,
    "DefaultLeaseSeconds": 60,
    "MaximumLeaseSeconds": 300,
    "MaximumPayloadBytes": 262144
  },
  "Identity": {
    "BaseUrl": "https://localhost:12512",
    "RequireHttps": true,
    "TimeoutSeconds": 5
  },
  "FileService": {
    "BaseUrl": "https://localhost:12513",
    "RequireHttps": true,
    "ClientName": "Business",
    "TimeoutSeconds": 60
  }
}
