# Copy this file to .env and replace every example value before starting the API container.
DEVKIT_BUSINESS_IMAGE=devkit-business:local
DEVKIT_IDENTITY_IMAGE=devkit-identity:local
DEVKIT_BUSINESS_VERSION=0.1.0
DEVKIT_IDENTITY_VERSION=0.1.0
DEVKIT_SERVER_HOST_PORT=8080
DEVKIT_WEB_HOST_IP=127.0.0.1
DEVKIT_WEB_HOST_PORT=8081
DEVKIT_IDENTITY_SQL_CONNECTION_STRING=Server=host.docker.internal,1433;Database=DevkitIdentity;User Id=devkit_identity;Password=replace-me;Encrypt=True;TrustServerCertificate=True
DEVKIT_BUSINESS_SQL_CONNECTION_STRING=Server=host.docker.internal,1433;Database=DevkitBusiness;User Id=devkit_business;Password=replace-me;Encrypt=True;TrustServerCertificate=True
DEVKIT_JWT_ISSUER=Devkit.Server
DEVKIT_JWT_AUDIENCE=Devkit.Clients
# Independent services require RSA keys outside the repository.
DEVKIT_IDENTITY_HOST_PORT=8082
DEVKIT_JWT_PRIVATE_KEY_FILE=D:/.server data/devkit/keys/identity-private.pem
DEVKIT_JWT_PUBLIC_KEY_FILE=D:/.server data/devkit/keys/business-public.pem
DEVKIT_REGISTRATION_ENABLED=false
DEVKIT_REDIS_HOST_PORT=6379
DEVKIT_QDRANT_HTTP_PORT=6333
DEVKIT_QDRANT_GRPC_PORT=6334
# Redis host data only; Qdrant stays in Docker named volumes on the Docker disk.
DEVKIT_DOCKER_DATA_ROOT=D:/.docker data
DEVKIT_DATA_ROOT=D:/.server data/devkit
DEVKIT_BOOTSTRAP_ENABLED=false
DEVKIT_BOOTSTRAP_USER_NAME=administrator
DEVKIT_BOOTSTRAP_EMAIL=administrator@example.invalid
DEVKIT_BOOTSTRAP_PASSWORD=ReplaceWithStrongBootstrapPassword123

# Independent file server (same verifier public key; never mount identity private key).
DEVKIT_FILESTORAGE_IMAGE=devkit-filestorage:local
DEVKIT_FILESTORAGE_VERSION=0.1.0
DEVKIT_FILESTORAGE_HOST_PORT=8083
DEVKIT_FILESTORAGE_SQL_CONNECTION_STRING=Server=host.docker.internal,1433;Database=DevkitFileStorage;User Id=devkit_files;Password=replace-me;Encrypt=True;TrustServerCertificate=True
# Generate a random secret of at least 32 UTF-8 bytes; use the same value for both services.
DEVKIT_FILE_SERVICE_API_KEY=
