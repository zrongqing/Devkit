# Browser requests stay on the Vite origin; the dev proxy forwards /api to this backend.
VITE_API_BASE_URL=/
VITE_DEV_API_TARGET=http://localhost:12511
# 认证、身份管理和导航菜单通过 Vite 同源代理访问独立身份服务。
VITE_DEV_AUTH_TARGET=http://localhost:12512
# 生产直连认证服务时配置；省略则继续使用 VITE_API_BASE_URL（网关入口）。
# VITE_AUTH_BASE_URL=https://auth.example.invalid

# Vite 开发服务器监听地址；局域网访问可改为 0.0.0.0
VITE_DEV_HOST=127.0.0.1
# Vite 开发服务器端口
VITE_DEV_PORT=5173
# npm run dev 后自动打开的页面路径；设为 false 可关闭自动打开
VITE_DEV_OPEN=/

# 独立文件服务：上传、下载、存储位置与迁移任务。
VITE_DEV_FILE_TARGET=http://localhost:12513
# VITE_FILE_BASE_URL=https://files.example.invalid
