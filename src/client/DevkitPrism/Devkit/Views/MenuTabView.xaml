<UserControl x:Class="Devkit.Views.MenuTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:Devkit.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MenuTabViewModel}"
             d:DesignHeight="300"
             d:DesignWidth="300">
  <UserControl.Resources>
    <DataTemplate x:Key="HeaderTemplate">
      <TextBlock Text="{Binding Header, Mode=TwoWay}" />
    </DataTemplate>

    <DataTemplate x:Key="ContentTemplate">
      <Label Content="{Binding Content}" />
    </DataTemplate>

    <DataTemplate x:Key="EditHeaderTemplate">
      <TextBox Text="{Binding Header, Mode=TwoWay}" />
    </DataTemplate>

    <DataTemplate x:Key="TabListContentTemplate">
      <TextBlock Text="{Binding Header}" />
    </DataTemplate>

    <Style x:Key="ItemStyle" TargetType="syncfusion:TabItemExt">
      <EventSetter Event="PreviewMouseLeftButtonDown"
                   Handler="OnTabItemPreviewMouseLeftButtonDown" />
      <EventSetter Event="PreviewMouseLeftButtonUp"
                   Handler="OnTabItemPreviewMouseLeftButtonUp" />
      <Setter Property="CanClose" Value="{Binding CanClose, Mode=TwoWay}" />
      <Setter Property="ShowPin" Value="{Binding ShowPin, Mode=TwoWay}" />
      <Setter Property="AllowPin" Value="{Binding AllowPin, Mode=TwoWay}" />
      <Setter Property="IsPinned" Value="{Binding IsPinned, Mode=TwoWay}" />
      <Setter Property="CloseButtonState" Value="{Binding CloseButtonState, Mode=TwoWay}" />
      <Setter Property="Height" Value="30" />
    </Style>
  </UserControl.Resources>

  <i:Interaction.Triggers>
    <i:EventTrigger EventName="Loaded">
      <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
    </i:EventTrigger>
    <i:EventTrigger EventName="Unloaded">
      <i:InvokeCommandAction Command="{Binding UnloadedCommand}" />
    </i:EventTrigger>
  </i:Interaction.Triggers>

  <Grid>
    <syncfusion:TabControlExt
      x:Name="MenuTabs"
      ItemsSource="{Binding Tabs}"
      SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
      BorderThickness="0"
      Padding="0"
      EditHeaderTemplate="{StaticResource EditHeaderTemplate}"
      ItemTemplate="{StaticResource HeaderTemplate}"
      ItemContainerStyle="{StaticResource ItemStyle}"
      TabItemLayout="SingleLine"
      AllowDragDrop="True"
      EnableLabelEdit="False"
      CloseButtonType="Common"
      TabItemHeaderStyle="Fill"
      >
      <!--<syncfusion:TabControlExt.ItemTemplate>
        <DataTemplate>
          <DockPanel LastChildFill="False">
            <TextBlock Text="{Binding Header}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right"
                    Width="18"
                    Height="18"
                    Padding="0"
                    Visibility="{Binding CloseButtonState}"
                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    CommandParameter="{Binding}"
                    ToolTip="关闭">
              <TextBlock Text="x"
                         FontSize="12"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Button>
          </DockPanel>
        </DataTemplate>
      </syncfusion:TabControlExt.ItemTemplate>-->
      <syncfusion:TabControlExt.ContentTemplate>
        <DataTemplate>
          <Grid>
            <ContentPresenter x:Name="TabContent"
                              Content="{Binding Content}" />
            <Border x:Name="LoadError"
                    Padding="24"
                    Background="#FFF8FAFC"
                    Visibility="Collapsed">
              <StackPanel HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          MaxWidth="560">
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Text="模块加载失败" />
                <TextBlock Margin="0,10,0,16"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding LoadErrorMessage}" />
                <Button Width="100"
                        Padding="12,6"
                        Command="{Binding DataContext.RetryTabCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        Content="重试" />
              </StackPanel>
            </Border>
          </Grid>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasLoadError}" Value="True">
              <Setter TargetName="TabContent" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="LoadError" Property="Visibility" Value="Visible" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </syncfusion:TabControlExt.ContentTemplate>
    </syncfusion:TabControlExt>
  </Grid>
</UserControl>
