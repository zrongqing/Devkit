<syncfusion:ChromelessWindow 
  x:Class="Devkit.Views.ShellWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
  xmlns:prism="http://prismlibrary.com/"
  prism:ViewModelLocator.AutoWireViewModel="True"
  xmlns:core="clr-namespace:Devkit.Core;assembly=Devkit.Core"
  Style="{StaticResource CustomMetroWindow}"
  mc:Ignorable="d"
  MinWidth="500"
  MinHeight="350">


  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition Width="1"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 左边菜单 -->
    <Border Background="#F8FAFC"
            BorderBrush="#E2E8F0"
            BorderThickness="0,0,1,0">
      <ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.MenuRegion}"/>
    </Border>

    <!-- 右边 Tab 区域 -->
    <ContentControl Grid.Column="2"
                    prism:RegionManager.RegionName="{x:Static core:RegionNames.MenuTabRegion}"/>
  </Grid>
  
</syncfusion:ChromelessWindow>
