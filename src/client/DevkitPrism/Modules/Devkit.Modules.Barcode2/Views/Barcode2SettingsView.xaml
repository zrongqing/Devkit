<coreViews:LoadingView x:Class="Barcode2.Views.Barcode2SettingsView"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:coreViews="clr-namespace:Devkit.Core.UI.Views;assembly=Devkit.Core.UI"
                       xmlns:viewModels="clr-namespace:Barcode2.ViewModels"
                       d:Background="White"
                       d:DataContext="{d:DesignInstance viewModels:Barcode2SettingsViewModel}"
                       d:DesignHeight="800"
                       d:DesignWidth="1200"
                       mc:Ignorable="d">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,10">
      <TextBlock VerticalAlignment="Center"
                 DockPanel.Dock="Left"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Text="Barcode2 配置" />
      <StackPanel HorizontalAlignment="Right"
                  DockPanel.Dock="Right"
                  Orientation="Horizontal">
        <Button MinWidth="80"
                Command="{Binding ReloadCommand}"
                Content="重新加载" />
        <Button MinWidth="80"
                Margin="8,0,0,0"
                Command="{Binding SaveCommand}"
                Content="保存" />
      </StackPanel>
    </DockPanel>

    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox Header="常规路径">
          <Grid Margin="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock VerticalAlignment="Center" Text="API 源码目录" />
            <TextBox Grid.Column="1"
                     Margin="8,3"
                     Text="{Binding SourceCodePath, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1"
                       VerticalAlignment="Center"
                       Text="Webapp 源码目录" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Margin="8,3"
                     Text="{Binding WebappSourcePath, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </GroupBox>

        <GroupBox Margin="0,12,0,0" Header="环境与数据库">
          <ItemsControl Margin="10" ItemsSource="{Binding Environments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,10"
                        Padding="10"
                        BorderBrush="#D5D9E0"
                        BorderThickness="1"
                        CornerRadius="3">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="3"
                               Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Text="{Binding DisplayName}" />
                    <Button Grid.Column="3"
                            MinWidth="72"
                            Margin="8,0,8,6"
                            HorizontalAlignment="Right"
                            Command="{Binding DataContext.TestEnvironmentCommand, RelativeSource={RelativeSource AncestorType={x:Type coreViews:LoadingView}}}"
                            CommandParameter="{Binding}"
                            Content="检测连接" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Oracle 数据源" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Margin="8,3"
                             Text="{Binding DatabaseDataSource, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               Text="服务器地址" />
                    <TextBox Grid.Row="1"
                             Grid.Column="3"
                             Margin="8,3"
                             Text="{Binding PageBaseAddress, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="数据库账号" />
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Margin="8,3"
                             Text="{Binding DatabaseUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               Text="数据库密码" />
                    <TextBox Grid.Row="2"
                             Grid.Column="3"
                             Margin="8,3"
                             Text="{Binding DatabasePassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </GroupBox>

        <GroupBox Margin="0,12,0,0" Header="Webapp 发布目标">
          <ItemsControl Margin="10" ItemsSource="{Binding ShareTargets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,10"
                        Padding="10"
                        BorderBrush="#D5D9E0"
                        BorderThickness="1"
                        CornerRadius="3">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="3"
                               Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Text="{Binding DisplayName}" />
                    <Button Grid.Column="3"
                            MinWidth="72"
                            Margin="8,0,8,6"
                            HorizontalAlignment="Right"
                            Command="{Binding DataContext.TestShareCommand, RelativeSource={RelativeSource AncestorType={x:Type coreViews:LoadingView}}}"
                            CommandParameter="{Binding}"
                            Content="检测连接" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Webapp 发布目录" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Grid.ColumnSpan="3"
                             Margin="8,3"
                             Text="{Binding Root, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="共享账号" />
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Margin="8,3"
                             Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               Text="共享密码" />
                    <TextBox Grid.Row="2"
                             Grid.Column="3"
                             Margin="8,3"
                             Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</coreViews:LoadingView>
