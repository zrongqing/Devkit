<coreViews:LoadingView
  x:Class="Ssamc.Views.ApiUpdateView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:prism="http://prismlibrary.com/"
  xmlns:behaviors="clr-namespace:Devkit.Core.UI.Behaviors;assembly=Devkit.Core.UI"
  xmlns:coreViews="clr-namespace:Devkit.Core.UI.Views;assembly=Devkit.Core.UI"
  xmlns:viewModels="clr-namespace:Ssamc.ViewModels"
  d:Background="White"
  d:DataContext="{d:DesignInstance viewModels:ApiUpdateViewModel}"
  d:DesignHeight="800"
  d:DesignWidth="1200"
  prism:ViewModelLocator.AutoWireViewModel="True"
  mc:Ignorable="d">
  <coreViews:LoadingView.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
        <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="CodePreviewTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      </Style>
    </ResourceDictionary>
  </coreViews:LoadingView.Resources>
  <Grid x:Name="PageContent"
        Margin="5">
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto"/>
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!--顶部菜单-->
      <Grid Grid.Row="0">
        <StackPanel Orientation="Horizontal">
          <Button Command="{Binding UpdateCommand}"
                CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"
                Content="215.58"
                Style="{StaticResource ButtonPrimary}" />
          <Button Margin="10,0,0,0" 
                Command="{Binding UpdateCommand}"
                CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"
                Content="20.54"
                Style="{StaticResource ButtonPrimary}" />
          <Button Margin="10,0,0,0"
                Command="{Binding ScanSourceCodeCommand}"
                CommandParameter="{Binding Text,ElementName=TbApiFolder}"
                Content="扫描"
                Style="{StaticResource ButtonPrimary}" />

        </StackPanel>
      </Grid>

      <StackPanel Orientation="Vertical"
                Grid.Row="1">
        <TextBox 
          Margin="0,10,0,0"
          x:Name="TbApiFolder"
          hc:InfoElement.Title="扫码路径"
          hc:InfoElement.TitlePlacement="Left"
          IsReadOnly="False"
          behaviors:TextBoxBehavior.EnterCommand="{Binding ScanSourceCodeCommand}"
          Style="{StaticResource TextBoxExtend}"
          Text="{Binding SourceCodePath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
        </TextBox>

        <!-- update apis -->
        <TextBox
          Margin="0,10,0,0"
          hc:InfoElement.Title="更新接口"
          hc:InfoElement.TitlePlacement="Left"
          ToolTip="(';'作为分隔符)"
          Style="{StaticResource TextBoxExtend}"
          Text="{Binding StrUpdateApis}" />

      </StackPanel>

      <!--API预览-->
      <Grid Grid.Row="2"
            Margin="0,5,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!--预览菜单-->
        <Grid Grid.Row="0" Grid.ColumnSpan="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Button
          Grid.Column="0"
          Command="{Binding PreviewCommand}"
          ToolTip="只能预览单个"
          Content="预览"
          Style="{StaticResource ButtonPrimary}" />
          <TextBox
          Grid.Column="1"
          x:Name="PreApicode"
          Margin="10,0,10,0"
          hc:InfoElement.Necessary="True"
          hc:InfoElement.Placeholder="预览ApiCode"
          Style="{StaticResource TextBoxExtend}"
          Text="{Binding StrSelectApiCodes}" />
        </Grid>
        <!--预览代码区域-->
        <Grid Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <GroupBox Grid.Column="0"
                  Header="执行源代码"
                  VerticalContentAlignment="Top"
                  >
            <TextBox Style="{StaticResource CodePreviewTextBox}"
                   VerticalContentAlignment="Top"
                   HorizontalContentAlignment="Left"
                   d:Text="// 执行源代码预览&#10;var request = GetRequest();&#10;var result = await service.ExecuteAsync(request);&#10;return result;"
                   Text="{Binding SourceCodePreview, Mode=OneWay}" />
          </GroupBox>
          <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      ShowsPreview="True" />
          <GroupBox Grid.Column="2"
                  Header="扩展源代码">
            <TextBox Style="{StaticResource CodePreviewTextBox}"
                   VerticalContentAlignment="Top"
                   HorizontalContentAlignment="Left"
                   d:Text="// 扩展源代码预览&#10;public sealed class DemoApiExtension&#10;{&#10;    public void Configure()&#10;    {&#10;        // extension setup&#10;    }&#10;}"
                   Text="{Binding CodePreview, Mode=OneWay}" />
          </GroupBox>
        </Grid>
      </Grid>
  </Grid>
</coreViews:LoadingView>
