{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=Devkit;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "Devkit.Server",
    "Audience": "Devkit.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Registration": {
    "Enabled": false
  },
  "BootstrapAccount": {
    "Enabled": false
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false",
    "InstanceName": "devkit:",
    "ProfileTtlMinutes": 5
  },
  "BackgroundJobs": {
    "RefreshTokenCleanup": {
      "Enabled": true,
      "IntervalMinutes": 60
    }
  }
}
